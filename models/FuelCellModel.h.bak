/*
  FuelCellModel: Full MEA fuel cell operando simulator
  
  Hybrid Color-Gradient + Shan-Chen pseudopotential + Greyscale LBM for
  multi-component multiphase flow with thermodynamic EoS in a multiscale
  domain (resolved void + greyscale MPL/CL + membrane diffusion), coupled
  with Butler-Volmer electrochemistry and non-isothermal energy transport.

  =========================================================================
  DOMAIN REGIONS (from micro-CT segmentation label map):
    Label 0     = solid (bounce-back): bipolar plate, carbon fiber
    Label 1     = resolved void (porosity=1): channels, GDL pores
    Label 2     = MPL: greyscale (porosity/permeability fields)
    Label 3     = catalyst layer (CL): greyscale + reaction source terms
    Label 4     = membrane: diffusion-only (Springer model)
    Labels 5+   = reserved for future use

  =========================================================================
  LATTICE SYSTEM (per active voxel):
    D3Q19       fq          Momentum (liquid water + gas mixture)
    D3Q7 x2     Aq, Bq      Phase A (liquid), Phase B (gas) densities
    D3Q7 x4     Cq[0..3]    Species: O2, N2, H2, H2O_vapor
    D3Q7         Tq          Temperature
    Scalar x2    PhiS, PhiE  Electronic / protonic potential (Laplace)
  =========================================================================
*/
#ifndef FUELCELLMODEL_H
#define FUELCELLMODEL_H

#include "common/ScaLBL.h"
#include "common/Communication.h"
#include "common/MPI_Helpers.h"
#include "analysis/distance.h"

#include <string>
#include <vector>
#include <memory>

// Species indices
enum SpeciesIndex { SP_O2 = 0, SP_N2 = 1, SP_H2 = 2, SP_H2OV = 3, NUM_SPECIES = 4 };

// Region labels (from segmented micro-CT)
enum RegionLabel {
    REGION_SOLID    = 0,
    REGION_VOID     = 1,
    REGION_MPL      = 2,
    REGION_CL       = 3,
    REGION_MEMBRANE = 4
};

class ScaLBL_FuelCellModel {
public:
    ScaLBL_FuelCellModel(int RANK, int NP, MPI_Comm COMM);
    ~ScaLBL_FuelCellModel();

    // ---- Lifecycle (call in order) ----
    void ReadParams(std::string filename);
    void SetDomain();
    void ReadInput();
    void Create();
    void Initialize();
    void Run();
    void WriteDebug();

    // ---- Two-phase parameters ----
    bool Restart;
    int timestep, timestepMax;
    int BoundaryCondition;
    double tauA, tauB;           // relaxation times (liquid, gas)
    double rhoA, rhoB;           // lattice densities
    double alpha, beta;          // interfacial tension param, recoloring width
    double Fx, Fy, Fz, flux;    // body force, flux BC
    double din, dout;            // inlet/outlet density (pressure BC)
    double inletA, inletB;       // inlet phase fractions
    double outletA, outletB;     // outlet phase fractions

    // ---- SI conversion ----
    double dx_si, dt_si, rho_ref;

    // ---- Shan-Chen / Carnahan-Starling EoS ----
    double sc_G;                  // SC interaction strength
    double cs_a, cs_b;            // CS EoS parameters: a, b
    double cs_T;                  // reduced temperature T/T_c

    // ---- Greyscale porous media ----
    double tauA_eff, tauB_eff;   // effective tau in greyscale regions

    // ---- Species transport ----
    double D_O2, D_N2, D_H2, D_H2Ov;              // diffusivities [lattice]
    double c_O2_in, c_N2_in, c_H2_in, c_H2Ov_in;  // inlet concentrations

    // ---- Electrochemistry ----
    double i0_cathode;    // exchange current density cathode [A/m^2]
    double i0_anode;      // exchange current density anode [A/m^2]
    double alpha_a_c;     // transfer coeff cathode anodic
    double alpha_c_c;     // transfer coeff cathode cathodic
    double alpha_a_a;     // transfer coeff anode anodic
    double alpha_c_a;     // transfer coeff anode cathodic
    double E_eq;          // equilibrium potential [V]
    double F_const;       // Faraday constant 96485 C/mol
    double R_gas;         // gas constant 8.314 J/(mol·K)
    double sigma_s;       // electronic conductivity [S/m]
    double sigma_e;       // protonic conductivity [S/m]
    double V_cell;        // cell voltage [V]
    int    electro_interval; // solve potentials every N steps

    // ---- Thermal ----
    double T_ref;               // reference temperature [K]
    double k_thermal_gas;       // thermal conductivity gas [W/(m·K)]
    double k_thermal_liquid;    // thermal conductivity liquid
    double k_thermal_GDL;       // thermal conductivity GDL
    double k_thermal_membrane;  // thermal conductivity membrane
    double h_fg;                // latent heat of vaporization [J/kg]
    double cp_ref;              // specific heat capacity [J/(kg·K)]

    // ---- Membrane (Springer model) ----
    double lambda_membrane;     // water content
    double n_drag;              // electro-osmotic drag coefficient

    // ---- Domain ----
    int Nx, Ny, Nz, N, Np;
    int rank, nprocx, nprocy, nprocz, nprocs;
    double Lx, Ly, Lz;

    // ---- Infrastructure ----
    std::shared_ptr<Domain> Dm;
    std::shared_ptr<Domain> Mask;
    std::shared_ptr<ScaLBL_Communicator> ScaLBL_Comm;
    std::shared_ptr<ScaLBL_Communicator> ScaLBL_Comm_Regular;

    // ---- Input databases ----
    std::shared_ptr<Database> db;
    std::shared_ptr<Database> domain_db;
    std::shared_ptr<Database> color_db;        // two-phase params
    std::shared_ptr<Database> fuelcell_db;     // FC-specific params
    std::shared_ptr<Database> analysis_db;

    IntArray Map;

    // ---- Host arrays ----
    char *id;              // label map

    // ---- Device arrays: momentum (D3Q19) ----
    int *NeighborList;
    int *dvcMap;
    double *fq;            // D3Q19 distributions [19*Np]
    double *Aq, *Bq;       // D3Q7 phase A,B [7*Np each]
    double *Den;            // densities [2*Np]: Den[n]=nA, Den[Np+n]=nB
    double *Phi;            // phase field [N_full]
    double *ColorGrad;      // color gradient [3*Np]
    double *Velocity;       // velocity [3*Np]
    double *Pressure;       // pressure [Np]

    // ---- Device arrays: greyscale ----
    double *Poros;          // porosity per voxel [Np]
    double *Perm;           // permeability per voxel [Np]
    double *GreySolidGrad;  // grey-solid gradient [3*Np]

    // ---- Device arrays: species (D3Q7 each, 7*Np) ----
    double *Cq[NUM_SPECIES];        // species distributions
    double *ConcentrationDev[NUM_SPECIES]; // concentration fields [Np]

    // ---- Device arrays: temperature ----
    double *Tq;             // thermal D3Q7 distributions [7*Np]
    double *Temperature;    // temperature field [Np]

    // ---- Device arrays: potentials ----
    double *PhiS;           // electronic potential [Np]
    double *PhiE;           // protonic potential [Np]

    // ---- Device arrays: per-voxel material ----
    double *RegionID;       // region label per active voxel [Np]
    double *DiffCoeff;      // effective diffusivity per voxel [Np]
    double *ThermalCond;    // thermal conductivity per voxel [Np]
    double *ElecCond;       // electronic conductivity per voxel [Np]
    double *IonCond;        // ionic conductivity per voxel [Np]

    // ---- Device arrays: source terms ----
    double *ReactionRate;   // current density j at CL voxels [Np]

    // ---- Cartesian arrays (for output) ----
    DoubleArray Distance;
    DoubleArray PhaseField;
    DoubleArray Pressure_Cart;
    DoubleArray Velocity_x, Velocity_y, Velocity_z;
    DoubleArray Temperature_Cart;
    DoubleArray Concentration_Cart[NUM_SPECIES];
    DoubleArray PhiS_Cart, PhiE_Cart;

private:
    MPI_Comm comm;
    size_t dist_mem_size;
    size_t neighborSize;
    char LocalRankString[8];
    char LocalRankFilename[40];
    char LocalRestartFile[40];

    void LoadParams(std::shared_ptr<Database> db0);
    void AssignComponentLabels();
    void AssignMaterialProperties();
    void SolveElectricPotentials();
    void ComputeButlerVolmerSources();
    void ComputePhaseChangeSources();
};

#endif
