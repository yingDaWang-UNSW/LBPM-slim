/*
  FuelCell.cpp — CPU fallback kernels for the Fuel Cell model
  
  These are simplified CPU implementations of the GPU kernels
  for debugging and CPU-only builds.
*/
#include <math.h>
#include <stdio.h>
#include <algorithm>

// =========================================================================
//  Carnahan-Starling EoS helpers (CPU versions)
// =========================================================================
static inline double CS_EoS_Pressure_CPU(double rho, double a, double b, double T_R)
{
    double eta = b * rho * 0.25;
    double denom = (1.0 - eta);
    double num = 1.0 + eta + eta * eta - eta * eta * eta;
    return rho * T_R * num / (denom * denom * denom) - a * rho * rho;
}

static inline double SC_EffectiveMass_CPU(double rho, double G, double a, double b, double T_R)
{
    double p = CS_EoS_Pressure_CPU(rho, a, b, T_R);
    double cs2 = 1.0 / 3.0;
    double arg = 2.0 * (p - rho * cs2) / (G * cs2);
    if (arg < 0.0) arg = 0.0;
    return sqrt(arg);
}

// =========================================================================
//  Shan-Chen pseudopotential force (even timestep)
// =========================================================================
extern "C" void ScaLBL_D3Q19_AAeven_ShanChen_Force(
    int *Map, double *Den, double *Phi,
    double *ForceX, double *ForceY, double *ForceZ,
    double G, double cs_a, double cs_b, double cs_T,
    double rhoA, double rhoB,
    int strideY, int strideZ, int start, int finish, int Np)
{
    const double w_face = 1.0 / 18.0;
    const double w_edge = 1.0 / 36.0;

    for (int n = start; n < finish; n++) {
        double nA = Den[n];
        double nB = Den[Np + n];
        double phi = (nA - nB) / (nA + nB);
        phi = std::min(1.0, std::max(-1.0, phi));
        double rho_local = rhoA + 0.5 * (1.0 - phi) * (rhoB - rhoA);
        int ijk = Map[n];
        double psi = SC_EffectiveMass_CPU(rho_local, G, cs_a, cs_b, cs_T);

        auto phi2rho = [&](double p) -> double {
            return rhoA + 0.5 * (1.0 - p) * (rhoB - rhoA);
        };
        auto psi_of_phi = [&](double p) -> double {
            return SC_EffectiveMass_CPU(phi2rho(p), G, cs_a, cs_b, cs_T);
        };

        double psi_px = psi_of_phi(Phi[ijk + 1]);
        double psi_mx = psi_of_phi(Phi[ijk - 1]);
        double psi_py = psi_of_phi(Phi[ijk + strideY]);
        double psi_my = psi_of_phi(Phi[ijk - strideY]);
        double psi_pz = psi_of_phi(Phi[ijk + strideZ]);
        double psi_mz = psi_of_phi(Phi[ijk - strideZ]);

        double psi_pxpy = psi_of_phi(Phi[ijk + 1 + strideY]);
        double psi_mxmy = psi_of_phi(Phi[ijk - 1 - strideY]);
        double psi_pxmy = psi_of_phi(Phi[ijk + 1 - strideY]);
        double psi_mxpy = psi_of_phi(Phi[ijk - 1 + strideY]);
        double psi_pxpz = psi_of_phi(Phi[ijk + 1 + strideZ]);
        double psi_mxmz = psi_of_phi(Phi[ijk - 1 - strideZ]);
        double psi_pxmz = psi_of_phi(Phi[ijk + 1 - strideZ]);
        double psi_mxpz = psi_of_phi(Phi[ijk - 1 + strideZ]);
        double psi_pypz = psi_of_phi(Phi[ijk + strideY + strideZ]);
        double psi_mymz = psi_of_phi(Phi[ijk - strideY - strideZ]);
        double psi_pymz = psi_of_phi(Phi[ijk + strideY - strideZ]);
        double psi_mypz = psi_of_phi(Phi[ijk - strideY + strideZ]);

        ForceX[n] = -G * psi * (
            w_face * (psi_px - psi_mx) +
            w_edge * (psi_pxpy - psi_mxmy + psi_pxmy - psi_mxpy +
                      psi_pxpz - psi_mxmz + psi_pxmz - psi_mxpz));
        ForceY[n] = -G * psi * (
            w_face * (psi_py - psi_my) +
            w_edge * (psi_pxpy - psi_mxmy - psi_pxmy + psi_mxpy +
                      psi_pypz - psi_mymz + psi_pymz - psi_mypz));
        ForceZ[n] = -G * psi * (
            w_face * (psi_pz - psi_mz) +
            w_edge * (psi_pxpz - psi_mxmz - psi_pxmz + psi_mxpz +
                      psi_pypz - psi_mymz - psi_pymz + psi_mypz));
    }
}

extern "C" void ScaLBL_D3Q19_AAodd_ShanChen_Force(
    int *neighborList, int *Map, double *Den, double *Phi,
    double *ForceX, double *ForceY, double *ForceZ,
    double G, double cs_a, double cs_b, double cs_T,
    double rhoA, double rhoB,
    int strideY, int strideZ, int start, int finish, int Np)
{
    // Identical to even version (force uses Cartesian Phi, not dist)
    ScaLBL_D3Q19_AAeven_ShanChen_Force(
        Map, Den, Phi, ForceX, ForceY, ForceZ,
        G, cs_a, cs_b, cs_T, rhoA, rhoB,
        strideY, strideZ, start, finish, Np);
}

// =========================================================================
//  D3Q7 Species Transport
// =========================================================================
extern "C" void ScaLBL_D3Q7_AAeven_FuelCell_Species(
    int *Map, double *Cq, double *Conc, double *Velocity,
    double *Phi, double *Poros, double *DiffCoeff, double *SourceTerm,
    double tau_sp, int start, int finish, int Np)
{
    const double w0 = 0.25;
    const double w1 = 0.125;

    for (int n = start; n < finish; n++) {
        int ijk = Map[n];
        double porosity = Poros[n];
        double diff_eff = DiffCoeff[n];
        double source = SourceTerm[n];
        double ux = Velocity[n];
        double uy = Velocity[Np + n];
        double uz = Velocity[2 * Np + n];
        double phi = Phi[ijk];
        double gas_mask = (phi < 0.5) ? 1.0 : 0.0;

        double f0 = Cq[0 * Np + n];
        double f1 = Cq[1 * Np + n];
        double f2 = Cq[2 * Np + n];
        double f3 = Cq[3 * Np + n];
        double f4 = Cq[4 * Np + n];
        double f5 = Cq[5 * Np + n];
        double f6 = Cq[6 * Np + n];

        double C = f0 + f1 + f2 + f3 + f4 + f5 + f6;
        double tau_eff = 0.5 + (tau_sp - 0.5) * porosity * diff_eff;
        double rlx_eff = 1.0 / tau_eff;

        Cq[0 * Np + n] = f0 * (1.0 - rlx_eff) + rlx_eff * w0 * C + w0 * source * gas_mask;
        Cq[1 * Np + n] = f1 * (1.0 - rlx_eff) + rlx_eff * w1 * C * (1.0 + 3.0 * ux) + w1 * source * gas_mask;
        Cq[2 * Np + n] = f2 * (1.0 - rlx_eff) + rlx_eff * w1 * C * (1.0 - 3.0 * ux) + w1 * source * gas_mask;
        Cq[3 * Np + n] = f3 * (1.0 - rlx_eff) + rlx_eff * w1 * C * (1.0 + 3.0 * uy) + w1 * source * gas_mask;
        Cq[4 * Np + n] = f4 * (1.0 - rlx_eff) + rlx_eff * w1 * C * (1.0 - 3.0 * uy) + w1 * source * gas_mask;
        Cq[5 * Np + n] = f5 * (1.0 - rlx_eff) + rlx_eff * w1 * C * (1.0 + 3.0 * uz) + w1 * source * gas_mask;
        Cq[6 * Np + n] = f6 * (1.0 - rlx_eff) + rlx_eff * w1 * C * (1.0 - 3.0 * uz) + w1 * source * gas_mask;

        Conc[n] = C;
    }
}

extern "C" void ScaLBL_D3Q7_AAodd_FuelCell_Species(
    int *neighborList, int *Map, double *Cq, double *Conc, double *Velocity,
    double *Phi, double *Poros, double *DiffCoeff, double *SourceTerm,
    double tau_sp, int start, int finish, int Np)
{
    const double w0 = 0.25;
    const double w1 = 0.125;

    for (int n = start; n < finish; n++) {
        int ijk = Map[n];
        double porosity = Poros[n];
        double diff_eff = DiffCoeff[n];
        double source = SourceTerm[n];
        double ux = Velocity[n];
        double uy = Velocity[Np + n];
        double uz = Velocity[2 * Np + n];
        double phi = Phi[ijk];
        double gas_mask = (phi < 0.5) ? 1.0 : 0.0;

        double f0 = Cq[n];
        int nread;
        nread = neighborList[n];           double f1 = Cq[nread];
        nread = neighborList[n + Np];      double f2 = Cq[nread];
        nread = neighborList[n + 2 * Np];  double f3 = Cq[nread];
        nread = neighborList[n + 3 * Np];  double f4 = Cq[nread];
        nread = neighborList[n + 4 * Np];  double f5 = Cq[nread];
        nread = neighborList[n + 5 * Np];  double f6 = Cq[nread];

        double C = f0 + f1 + f2 + f3 + f4 + f5 + f6;
        double tau_eff = 0.5 + (tau_sp - 0.5) * porosity * diff_eff;
        double rlx_eff = 1.0 / tau_eff;

        f0 = f0 * (1.0 - rlx_eff) + rlx_eff * w0 * C + w0 * source * gas_mask;
        f1 = f1 * (1.0 - rlx_eff) + rlx_eff * w1 * C * (1.0 + 3.0 * ux) + w1 * source * gas_mask;
        f2 = f2 * (1.0 - rlx_eff) + rlx_eff * w1 * C * (1.0 - 3.0 * ux) + w1 * source * gas_mask;
        f3 = f3 * (1.0 - rlx_eff) + rlx_eff * w1 * C * (1.0 + 3.0 * uy) + w1 * source * gas_mask;
        f4 = f4 * (1.0 - rlx_eff) + rlx_eff * w1 * C * (1.0 - 3.0 * uy) + w1 * source * gas_mask;
        f5 = f5 * (1.0 - rlx_eff) + rlx_eff * w1 * C * (1.0 + 3.0 * uz) + w1 * source * gas_mask;
        f6 = f6 * (1.0 - rlx_eff) + rlx_eff * w1 * C * (1.0 - 3.0 * uz) + w1 * source * gas_mask;

        Cq[n] = f0;
        nread = neighborList[n];           Cq[nread] = f1;
        nread = neighborList[n + Np];      Cq[nread] = f2;
        nread = neighborList[n + 2 * Np];  Cq[nread] = f3;
        nread = neighborList[n + 3 * Np];  Cq[nread] = f4;
        nread = neighborList[n + 4 * Np];  Cq[nread] = f5;
        nread = neighborList[n + 5 * Np];  Cq[nread] = f6;

        Conc[n] = C;
    }
}

// =========================================================================
//  D3Q7 Potential Solver
// =========================================================================
extern "C" void ScaLBL_D3Q7_AAeven_FuelCell_Potential(
    int *Map, double *Pq, double *PotentialField, double *Conductivity,
    int start, int finish, int Np)
{
    const double w0 = 0.25;
    const double w1 = 0.125;

    for (int n = start; n < finish; n++) {
        double sigma_local = Conductivity[n];
        double tau_pot = 0.5 + 3.0 * sigma_local;
        if (tau_pot < 0.501) tau_pot = 0.501;
        double rlx = 1.0 / tau_pot;

        double f0 = Pq[0 * Np + n];
        double f1 = Pq[1 * Np + n];
        double f2 = Pq[2 * Np + n];
        double f3 = Pq[3 * Np + n];
        double f4 = Pq[4 * Np + n];
        double f5 = Pq[5 * Np + n];
        double f6 = Pq[6 * Np + n];

        double pot = f0 + f1 + f2 + f3 + f4 + f5 + f6;

        Pq[0 * Np + n] = f0 * (1.0 - rlx) + rlx * w0 * pot;
        Pq[1 * Np + n] = f1 * (1.0 - rlx) + rlx * w1 * pot;
        Pq[2 * Np + n] = f2 * (1.0 - rlx) + rlx * w1 * pot;
        Pq[3 * Np + n] = f3 * (1.0 - rlx) + rlx * w1 * pot;
        Pq[4 * Np + n] = f4 * (1.0 - rlx) + rlx * w1 * pot;
        Pq[5 * Np + n] = f5 * (1.0 - rlx) + rlx * w1 * pot;
        Pq[6 * Np + n] = f6 * (1.0 - rlx) + rlx * w1 * pot;

        PotentialField[n] = pot;
    }
}

extern "C" void ScaLBL_D3Q7_AAodd_FuelCell_Potential(
    int *neighborList, int *Map, double *Pq, double *PotentialField,
    double *Conductivity, int start, int finish, int Np)
{
    const double w0 = 0.25;
    const double w1 = 0.125;

    for (int n = start; n < finish; n++) {
        double sigma_local = Conductivity[n];
        double tau_pot = 0.5 + 3.0 * sigma_local;
        if (tau_pot < 0.501) tau_pot = 0.501;
        double rlx = 1.0 / tau_pot;

        double f0 = Pq[n];
        int nread;
        nread = neighborList[n];           double f1 = Pq[nread];
        nread = neighborList[n + Np];      double f2 = Pq[nread];
        nread = neighborList[n + 2 * Np];  double f3 = Pq[nread];
        nread = neighborList[n + 3 * Np];  double f4 = Pq[nread];
        nread = neighborList[n + 4 * Np];  double f5 = Pq[nread];
        nread = neighborList[n + 5 * Np];  double f6 = Pq[nread];

        double pot = f0 + f1 + f2 + f3 + f4 + f5 + f6;

        f0 = f0 * (1.0 - rlx) + rlx * w0 * pot;
        f1 = f1 * (1.0 - rlx) + rlx * w1 * pot;
        f2 = f2 * (1.0 - rlx) + rlx * w1 * pot;
        f3 = f3 * (1.0 - rlx) + rlx * w1 * pot;
        f4 = f4 * (1.0 - rlx) + rlx * w1 * pot;
        f5 = f5 * (1.0 - rlx) + rlx * w1 * pot;
        f6 = f6 * (1.0 - rlx) + rlx * w1 * pot;

        Pq[n] = f0;
        nread = neighborList[n];           Pq[nread] = f1;
        nread = neighborList[n + Np];      Pq[nread] = f2;
        nread = neighborList[n + 2 * Np];  Pq[nread] = f3;
        nread = neighborList[n + 3 * Np];  Pq[nread] = f4;
        nread = neighborList[n + 4 * Np];  Pq[nread] = f5;
        nread = neighborList[n + 5 * Np];  Pq[nread] = f6;

        PotentialField[n] = pot;
    }
}

// =========================================================================
//  D3Q7 Thermal Transport
// =========================================================================
extern "C" void ScaLBL_D3Q7_AAeven_FuelCell_Thermal(
    int *Map, double *Tq, double *Temperature, double *Velocity,
    double *ThermalCond, double *SourceThermal,
    double tau_thermal, int start, int finish, int Np)
{
    const double w0 = 0.25;
    const double w1 = 0.125;

    for (int n = start; n < finish; n++) {
        double kth = ThermalCond[n];
        double source = SourceThermal[n];
        double ux = Velocity[n];
        double uy = Velocity[Np + n];
        double uz = Velocity[2 * Np + n];

        double tau_eff = 0.5 + 3.0 * kth;
        double rlx = 1.0 / tau_eff;

        double f0 = Tq[0 * Np + n];
        double f1 = Tq[1 * Np + n];
        double f2 = Tq[2 * Np + n];
        double f3 = Tq[3 * Np + n];
        double f4 = Tq[4 * Np + n];
        double f5 = Tq[5 * Np + n];
        double f6 = Tq[6 * Np + n];

        double T = f0 + f1 + f2 + f3 + f4 + f5 + f6;

        Tq[0 * Np + n] = f0 * (1.0 - rlx) + rlx * w0 * T + w0 * source;
        Tq[1 * Np + n] = f1 * (1.0 - rlx) + rlx * w1 * T * (1.0 + 3.0 * ux) + w1 * source;
        Tq[2 * Np + n] = f2 * (1.0 - rlx) + rlx * w1 * T * (1.0 - 3.0 * ux) + w1 * source;
        Tq[3 * Np + n] = f3 * (1.0 - rlx) + rlx * w1 * T * (1.0 + 3.0 * uy) + w1 * source;
        Tq[4 * Np + n] = f4 * (1.0 - rlx) + rlx * w1 * T * (1.0 - 3.0 * uy) + w1 * source;
        Tq[5 * Np + n] = f5 * (1.0 - rlx) + rlx * w1 * T * (1.0 + 3.0 * uz) + w1 * source;
        Tq[6 * Np + n] = f6 * (1.0 - rlx) + rlx * w1 * T * (1.0 - 3.0 * uz) + w1 * source;

        Temperature[n] = T;
    }
}

extern "C" void ScaLBL_D3Q7_AAodd_FuelCell_Thermal(
    int *neighborList, int *Map, double *Tq, double *Temperature,
    double *Velocity, double *ThermalCond, double *SourceThermal,
    double tau_thermal, int start, int finish, int Np)
{
    const double w0 = 0.25;
    const double w1 = 0.125;

    for (int n = start; n < finish; n++) {
        double kth = ThermalCond[n];
        double source = SourceThermal[n];
        double ux = Velocity[n];
        double uy = Velocity[Np + n];
        double uz = Velocity[2 * Np + n];

        double tau_eff = 0.5 + 3.0 * kth;
        double rlx = 1.0 / tau_eff;

        double f0 = Tq[n];
        int nread;
        nread = neighborList[n];           double f1 = Tq[nread];
        nread = neighborList[n + Np];      double f2 = Tq[nread];
        nread = neighborList[n + 2 * Np];  double f3 = Tq[nread];
        nread = neighborList[n + 3 * Np];  double f4 = Tq[nread];
        nread = neighborList[n + 4 * Np];  double f5 = Tq[nread];
        nread = neighborList[n + 5 * Np];  double f6 = Tq[nread];

        double T = f0 + f1 + f2 + f3 + f4 + f5 + f6;

        f0 = f0 * (1.0 - rlx) + rlx * w0 * T + w0 * source;
        f1 = f1 * (1.0 - rlx) + rlx * w1 * T * (1.0 + 3.0 * ux) + w1 * source;
        f2 = f2 * (1.0 - rlx) + rlx * w1 * T * (1.0 - 3.0 * ux) + w1 * source;
        f3 = f3 * (1.0 - rlx) + rlx * w1 * T * (1.0 + 3.0 * uy) + w1 * source;
        f4 = f4 * (1.0 - rlx) + rlx * w1 * T * (1.0 - 3.0 * uy) + w1 * source;
        f5 = f5 * (1.0 - rlx) + rlx * w1 * T * (1.0 + 3.0 * uz) + w1 * source;
        f6 = f6 * (1.0 - rlx) + rlx * w1 * T * (1.0 - 3.0 * uz) + w1 * source;

        Tq[n] = f0;
        nread = neighborList[n];           Tq[nread] = f1;
        nread = neighborList[n + Np];      Tq[nread] = f2;
        nread = neighborList[n + 2 * Np];  Tq[nread] = f3;
        nread = neighborList[n + 3 * Np];  Tq[nread] = f4;
        nread = neighborList[n + 4 * Np];  Tq[nread] = f5;
        nread = neighborList[n + 5 * Np];  Tq[nread] = f6;

        Temperature[n] = T;
    }
}

// =========================================================================
//  Butler-Volmer Source
// =========================================================================
extern "C" void ScaLBL_FuelCell_ButlerVolmer(
    double *PhiS, double *PhiE, double *Temperature,
    double *RegionID, double *ReactionRate,
    double *SourceO2, double *SourceN2, double *SourceH2, double *SourceH2O,
    double i0_cathode, double i0_anode,
    double alpha_a_c, double alpha_c_c,
    double alpha_a_a, double alpha_c_a,
    double E_eq, double F_const, double R_gas,
    int start, int finish, int Np)
{
    for (int n = start; n < finish; n++) {
        double region = RegionID[n];
        double phiS = PhiS[n];
        double phiE = PhiE[n];
        double T_local = Temperature[n];
        if (T_local < 0.1) T_local = 1.0;

        if (fabs(region - 3.0) < 0.5) {
            double eta = phiS - phiE - E_eq;
            double i0 = i0_cathode;
            double j = i0 * (exp(alpha_a_c * F_const * eta / (R_gas * T_local))
                           - exp(-alpha_c_c * F_const * eta / (R_gas * T_local)));
            j = std::min(std::max(j, -1.0e4), 1.0e4);

            ReactionRate[n] = j;
            SourceO2[n]  = -j / (4.0 * F_const);
            SourceN2[n]  = 0.0;
            SourceH2[n]  = 0.0;
            SourceH2O[n] = j / (2.0 * F_const);
        } else {
            ReactionRate[n] = 0.0;
            SourceO2[n]  = 0.0;
            SourceN2[n]  = 0.0;
            SourceH2[n]  = 0.0;
            SourceH2O[n] = 0.0;
        }
    }
}

// =========================================================================
//  Phase Change Source
// =========================================================================
extern "C" void ScaLBL_FuelCell_PhaseChange(
    double *Phi, double *Temperature, double *ConcH2O,
    double *SourcePhaseField, double *SourceThermal,
    double h_fg, double R_gas, double T_ref, double P_ref,
    double k_evap, double k_cond,
    int *Map, int start, int finish, int Np)
{
    const double M_H2O = 0.018;

    for (int n = start; n < finish; n++) {
        int ijk = Map[n];
        double T = Temperature[n];
        if (T < 0.1) T = 1.0;
        double c_h2o = ConcH2O[n];
        double phi = Phi[ijk];

        double P_h2o = c_h2o / 3.0;
        double P_sat = P_ref * exp(h_fg * M_H2O / R_gas * (1.0 / T_ref - 1.0 / T));

        double dm = 0.0;
        if (P_h2o > P_sat && phi < 0.3) {
            dm = k_cond * (P_h2o - P_sat);
        } else if (P_h2o < P_sat && phi > -0.3) {
            dm = -k_evap * (P_sat - P_h2o);
        }

        SourcePhaseField[n] = dm;
        SourceThermal[n] = -dm * h_fg;
    }
}
